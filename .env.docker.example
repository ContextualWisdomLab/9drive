# Required. Generate unique values before running Docker Compose.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=9drive
MYSQL_USER=9drive
MYSQL_PASSWORD=
# Prisma consumes a MySQL connection URL. Set this to the percent-encoded
# representation of MYSQL_PASSWORD. For the README's hex-generated password,
# the encoded value is identical to the raw value.
MYSQL_PASSWORD_URLENCODED=

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_RECAPTCHA_SITE_KEY=

# Required. Use independently generated high-entropy values; do not reuse them.
JWT_ACCESS_SECRET=
TOKEN_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Optional until Google sign-in / Drive connection is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
RECAPTCHA_SECRET_KEY=
